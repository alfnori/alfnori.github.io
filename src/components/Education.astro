---
import { education, languages } from "../data/cv";
---

<section class="mx-auto max-w-5xl px-6 py-10 grid gap-8 md:grid-cols-2">
  <div>
    <h2 class="mech-section-header">Formação Acadêmica</h2>
    <div class="mt-6 space-y-3">
      {education.map((e) => (
        <div class="mech-panel p-5">
          <p class="font-display font-bold text-mech-text uppercase tracking-wide">{e.institution}</p>
          <p class="text-sm text-mech-text-secondary mt-1">{e.degree}</p>
          <p class="text-xs font-mono text-mech-text-muted mt-2">{e.period}</p>
        </div>
      ))}
    </div>
  </div>

  <div>
    <h2 class="mech-section-header">Idiomas</h2>
    <div class="mt-6 grid gap-3">
      {languages.map((l) => (
        <div class="mech-panel flex items-center justify-between px-5 py-4">
          <span class="font-display font-semibold text-mech-text uppercase tracking-wide">{l.name}</span>
          <span class="font-mono text-xs text-mech-cyan bg-mech-base border border-mech-border px-3 py-1 clip-mech-sm">{l.level}</span>
        </div>
      ))}
    </div>
  </div>
</section>
