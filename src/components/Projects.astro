---
import { projects } from "../data/projects";
---

<section id="projetos" class="mx-auto max-w-5xl px-6 py-8">
  <div class="flex items-end justify-between">
    <h2 class="text-sm font-semibold tracking-widest text-zinc-500 dark:text-zinc-400 uppercase">Projetos — em ordem cronológica</h2>
    <span class="text-xs text-zinc-500 dark:text-zinc-400">6 dummies editáveis em <code class="rounded bg-zinc-100 px-1.5 py-0.5 dark:bg-zinc-800">src/data/projects.ts</code></span>
  </div>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    {projects.map((p) => (
      <article class="group relative flex flex-col rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/50 hover:border-zinc-300 dark:hover:border-zinc-700 transition hover:shadow-md">
        <div class="flex items-center justify-between">
          <span class="inline-flex rounded-full bg-blue-600 px-2.5 py-1 text-xs font-bold text-white">{p.year}</span>
          <span class="text-xs text-zinc-500 dark:text-zinc-400">{p.id.toUpperCase()}</span>
        </div>
        <h3 class="mt-3 font-semibold text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">{p.title}</h3>
        <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400 flex-1">{p.description}</p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {p.tech.map((t) => (
            <span class="rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs text-zinc-700 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">{t}</span>
          ))}
        </div>
        <div class="mt-4 flex gap-3 text-sm font-medium">
          <a href={p.link} class="text-blue-600 hover:underline dark:text-blue-400">Demo →</a>
          <a href={p.repo} target="_blank" rel="noopener" class="text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Repo →</a>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-6 rounded-xl border border-dashed border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-200">
    ✏️ <strong>Como editar:</strong> abra <code>src/data/projects.ts</code> e troque <code>title</code>, <code>description</code>, <code>tech</code>, <code>link</code> e <code>repo</code> de cada projeto. Já estão em ordem cronológica reversa (2025 → 2018). Salve e faça push — deploy automático.
  </div>
</section>
