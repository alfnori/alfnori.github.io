---
import { projects } from "../data/projects";
---

<section id="projetos" class="mx-auto max-w-5xl px-6 py-10">
  <div class="flex items-end justify-between">
    <h2 class="mech-section-header">Projetos</h2>
    <span class="text-xs font-mono text-mech-text-muted">CRONOLOGIA_REVERSA</span>
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-2">
    {projects.map((p) => (
      <article class="mech-panel group flex flex-col p-6">
        <div class="flex items-center justify-between">
          <span class="inline-flex font-mono text-xs font-bold text-mech-base bg-mech-cyan px-2.5 py-1 clip-mech-sm">{p.year}</span>
          <span class="text-xs font-mono text-mech-text-muted">{p.id.toUpperCase()}</span>
        </div>
        <h3 class="mt-4 font-display font-bold text-base text-mech-text uppercase tracking-wide group-hover:text-mech-cyan transition-colors">{p.title}</h3>
        <p class="mt-2 text-sm leading-6 text-mech-text-secondary flex-1">{p.description}</p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {p.tech.map((t) => (
            <span class="mech-tag">{t}</span>
          ))}
        </div>
        <div class="mt-5 flex gap-4 text-xs font-mono font-semibold uppercase">
          <a href={p.link} class="text-mech-cyan hover:underline">Demo →</a>
          <a href={p.repo} target="_blank" rel="noopener" class="text-mech-text-secondary hover:text-mech-text">Repo →</a>
        </div>
      </article>
    ))}
  </div>

</section>
