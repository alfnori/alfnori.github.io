---
import { skills } from "../data/cv";
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-10">
  <h2 class="mech-section-header">Competências Técnicas</h2>
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {skills.map((group) => (
      <div class="mech-panel p-5">
        <h3 class="text-xs font-mono font-bold text-mech-cyan uppercase tracking-wider">{group.category}</h3>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {group.items.map((item) => (
            <span class="mech-tag">{item}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
