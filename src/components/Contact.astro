---
import { personal } from "../data/cv";
---

<section id="contato" class="mx-auto max-w-5xl px-6 py-8">
  <div class="rounded-2xl border border-zinc-200 bg-zinc-900 p-8 text-white dark:border-zinc-800 dark:bg-white dark:text-zinc-900">
    <h2 class="text-lg font-semibold">Vamos conversar?</h2>
    <p class="mt-2 text-sm text-zinc-300 dark:text-zinc-600">Aberto a oportunidades, freelas e colaborações. Resposta rápida por email ou LinkedIn.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`mailto:${personal.email}`} class="inline-flex items-center rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-zinc-900 hover:bg-zinc-100 dark:bg-zinc-900 dark:text-white dark:hover:bg-zinc-800 transition">
        ✉️ {personal.email}
      </a>
      <a href={personal.linkedin} target="_blank" rel="noopener" class="inline-flex items-center rounded-full border border-white/20 px-5 py-2.5 text-sm font-medium hover:bg-white/10 dark:border-zinc-300 dark:hover:bg-zinc-100 transition">
        LinkedIn
      </a>
      <a href={personal.github} target="_blank" rel="noopener" class="inline-flex items-center rounded-full border border-white/20 px-5 py-2.5 text-sm font-medium hover:bg-white/10 dark:border-zinc-300 dark:hover:bg-zinc-100 transition">
        GitHub
      </a>
    </div>
  </div>
</section>
