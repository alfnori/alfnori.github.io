<header class="sticky top-0 z-40 w-full border-b border-mech-border bg-mech-base/90 backdrop-blur-md">
	<div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
		<a
			href="#"
			class="flex items-center gap-3 font-display font-bold tracking-wider uppercase"
		>
			<span class="inline-flex h-9 w-9 items-center justify-center bg-mech-cyan text-mech-base text-xs font-mono font-bold clip-mech-sm">
				AN
			</span>
			<span class="hidden sm:inline text-sm text-mech-text-secondary">
				ADOLFO_NORILLER
			</span>
		</a>

		<nav class="hidden items-center gap-1 text-xs font-mono tracking-wider uppercase md:flex">
			<a
				href="#sobre"
				class="px-3 py-2 text-mech-text-secondary hover:text-mech-cyan transition-colors"
			>
				Sobre
			</a>
			<a
				href="#experiencia"
				class="px-3 py-2 text-mech-text-secondary hover:text-mech-cyan transition-colors"
			>
				Experiência
			</a>
			<a
				href="#skills"
				class="px-3 py-2 text-mech-text-secondary hover:text-mech-cyan transition-colors"
			>
				Skills
			</a>
			<a
				href="#projetos"
				class="px-3 py-2 text-mech-text-secondary hover:text-mech-cyan transition-colors"
			>
				Projetos
			</a>
			<a
				href="#contato"
				class="px-3 py-2 text-mech-text-secondary hover:text-mech-cyan transition-colors"
			>
				Contato
			</a>
		</nav>

		<div class="flex items-center gap-2">
			<a
				href="/cv.pdf"
				download
				class="hidden sm:inline-flex mech-btn mech-btn-ghost text-xs"
			>
				<svg
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
				>
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
					<polyline points="7 10 12 15 17 10" />
					<line x1="12" y1="15" x2="12" y2="3" />
				</svg>
				BAIXAR_CV
			</a>
		</div>
	</div>
</header>
