---
import { personal } from "../data/cv";
---

<section
	id="contato"
	class="mx-auto max-w-5xl px-6 py-12 md:py-20 scan-line-overlay"
>
	<div class="flex flex-col md:flex-row items-start md:items-center gap-8 md:gap-12">
		<div class="relative shrink-0">
			<div class="relative">
				<img
					src={personal.photo}
					alt="Foto de Adolfo Luiz Noriller"
					width="160"
					height="160"
					class="h-32 w-32 md:h-44 md:w-44 object-cover object-top clip-mech border border-mech-border"
					loading="eager"
					decoding="async"
				/>
				<div class="absolute inset-0 clip-mech border border-mech-cyan/20 pointer-events-none"></div>
			</div>
			<span class="absolute -bottom-2 -right-2 inline-flex items-center gap-1.5 bg-mech-surface border border-mech-green px-3 py-1 text-xs font-mono font-bold text-mech-green uppercase animate-pulse-glow clip-mech-sm">
				<span class="w-1.5 h-1.5 bg-mech-green rounded-full"></span>
				DISPONÍVEL
			</span>
		</div>

		<div class="flex-1">
			<p class="text-xs font-mono tracking-[0.2em] text-mech-cyan uppercase">
				{personal.title}
			</p>
			<h1 class="mt-3 font-display text-4xl md:text-5xl font-bold tracking-tight text-mech-text uppercase leading-tight">
				{personal.name}
			</h1>
			<p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-mono text-mech-text-secondary">
				<span class="flex items-center gap-1.5">
					<svg
						width="12"
						height="12"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					>
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
						<circle cx="12" cy="10" r="3" />
					</svg>
					{personal.location}
				</span>
				<span class="text-mech-border">|</span>
				<a
					href={`mailto:${personal.email}`}
					class="flex items-center gap-1.5 hover:text-mech-cyan transition-colors"
				>
					<svg
						width="12"
						height="12"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					>
						<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
						<polyline points="22,6 12,13 2,6" />
					</svg>
					{personal.email}
				</a>
				<span class="text-mech-border">|</span>
				<a
					href={`tel:${personal.phone}`}
					class="flex items-center gap-1.5 hover:text-mech-cyan transition-colors"
				>
					<svg
						width="12"
						height="12"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					>
						<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
					</svg>
					{personal.phone}
				</a>
			</p>

			<div class="mt-8 flex flex-wrap gap-3">
				<a
					href={personal.linkedin}
					target="_blank"
					rel="noopener"
					class="mech-btn mech-btn-ghost text-xs"
				>
					<svg
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="currentColor"
						aria-hidden="true"
					>
						<path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.26c-.97 0-1.75-.79-1.75-1.76s.78-1.76 1.75-1.76 1.75.79 1.75 1.76-.78 1.76-1.75 1.76zm13.5 11.26h-3v-5.6c0-1.34-.48-2.26-1.67-2.26-.91 0-1.45.61-1.69 1.2-.09.21-.11.5-.11.8v5.86h-3s.04-9.5 0-10.5h3v1.49c.4-.62 1.12-1.5 2.74-1.5 2 0 3.5 1.31 3.5 4.12v6.39z" />
					</svg>
					LINKEDIN
				</a>
				<a
					href={personal.github}
					target="_blank"
					rel="noopener"
					class="mech-btn mech-btn-ghost text-xs"
				>
					<svg
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="currentColor"
						aria-hidden="true"
					>
						<path d="M12 .5a11.5 11.5 0 0 0-3.64 22.42c.57.11.78-.25.78-.55v-1.96c-3.18.69-3.85-1.36-3.85-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.72-1.52-2.52-.29-5.17-1.26-5.17-5.61 0-1.24.44-2.25 1.17-3.05-.12-.29-.51-1.44.11-3 0 0 .96-.31 3.14 1.16a10.9 10.9 0 0 1 5.72 0c2.18-1.47 3.14-1.16 3.14-1.16.62 1.56.23 2.71.11 3 .73.8 1.17 1.81 1.17 3.05 0 4.36-2.65 5.31-5.18 5.6.41.35.78 1.03.78 2.08v3.08c0 .31.21.67.79.55A11.5 11.5 0 0 0 12 .5z" />
					</svg>
					GITHUB
				</a>
				<a
					href="/cv.pdf"
					target="_blank"
					class="mech-btn mech-btn-primary text-xs"
				>
					VER_CV_PDF →
				</a>
			</div>
		</div>
	</div>
</section>
