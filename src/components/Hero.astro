---
import { personal } from "../data/cv";
---

<section class="mx-auto max-w-5xl px-6 py-12 md:py-16">
  <div class="flex flex-col md:flex-row items-start md:items-center gap-8">
    <div class="relative shrink-0">
      <img
        src={personal.photo}
        alt="Foto de Adolfo Luiz Noriller"
        width="160"
        height="160"
        class="h-28 w-28 md:h-40 md:w-40 rounded-2xl object-cover object-top border border-zinc-200 dark:border-zinc-800 shadow-sm rotate-1"
        loading="eager"
        decoding="async"
      />
      <span class="absolute -bottom-2 -right-2 inline-flex items-center rounded-full bg-green-500 px-2.5 py-1 text-xs font-semibold text-white shadow">Disponível</span>
    </div>

    <div class="flex-1">
      <p class="text-sm font-medium tracking-widest text-blue-600 dark:text-blue-400 uppercase">{personal.title}</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight text-zinc-900 dark:text-white">
        {personal.name}
      </h1>
      <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-zinc-600 dark:text-zinc-400">
        <span>📍 {personal.location}</span>
        <span class="hidden sm:inline">•</span>
        <a href={`mailto:${personal.email}`} class="hover:text-blue-600 dark:hover:text-blue-400">✉️ {personal.email}</a>
        <span class="hidden sm:inline">•</span>
        <a href={`tel:${personal.phone}`} class="hover:text-blue-600 dark:hover:text-blue-400">{personal.phone}</a>
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href={personal.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-800 transition">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.26c-.97 0-1.75-.79-1.75-1.76s.78-1.76 1.75-1.76 1.75.79 1.75 1.76-.78 1.76-1.75 1.76zm13.5 11.26h-3v-5.6c0-1.34-.48-2.26-1.67-2.26-.91 0-1.45.61-1.69 1.2-.09.21-.11.5-.11.8v5.86h-3s.04-9.5 0-10.5h3v1.49c.4-.62 1.12-1.5 2.74-1.5 2 0 3.5 1.31 3.5 4.12v6.39z"/></svg>
          LinkedIn
        </a>
        <a href={personal.github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-800 transition">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.42c.57.11.78-.25.78-.55v-1.96c-3.18.69-3.85-1.36-3.85-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.72-1.52-2.52-.29-5.17-1.26-5.17-5.61 0-1.24.44-2.25 1.17-3.05-.12-.29-.51-1.44.11-3 0 0 .96-.31 3.14 1.16a10.9 10.9 0 0 1 5.72 0c2.18-1.47 3.14-1.16 3.14-1.16.62 1.56.23 2.71.11 3 .73.8 1.17 1.81 1.17 3.05 0 4.36-2.65 5.31-5.18 5.6.41.35.78 1.03.78 2.08v3.08c0 .31.21.67.79.55A11.5 11.5 0 0 0 12 .5z"/></svg>
          GitHub
        </a>
        <a href="/cv.pdf" target="_blank" class="inline-flex items-center gap-2 rounded-full bg-blue-600 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition shadow-sm">
          Ver CV em PDF →
        </a>
      </div>
    </div>
  </div>
</section>
