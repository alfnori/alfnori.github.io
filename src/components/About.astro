---
import { summary } from "../data/cv";
const paragraphs = summary.split("\n\n");
---

<section id="sobre" class="mx-auto max-w-5xl px-6 py-10">
  <h2 class="mech-section-header">Resumo Profissional</h2>
  <div class="mt-6 space-y-4 text-sm leading-7 text-mech-text-secondary font-body">
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>
</section>
