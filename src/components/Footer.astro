    <span class="flex gap-4">
      <a href="https://github.com/alfnori/alfnori.github.io" target="_blank" rel="noopener" class="hover:text-zinc-900 dark:hover:text-white">Código fonte</a>
      <a href="/cv.pdf" class="hover:text-zinc-900 dark:hover:text-white">PDF</a>
