---
import { experiences } from "../data/cv";
---

<section id="experiencia" class="mx-auto max-w-5xl px-6 py-10">
  <h2 class="mech-section-header">Experiência Profissional</h2>

  <div class="mt-8 relative">
    <!-- Angular timeline line -->
    <div class="absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-mech-cyan/40 via-mech-border to-transparent hidden md:block"></div>

    <div class="space-y-6">
      {experiences.map((exp, i) => (
        <article class="relative md:pl-8 group">
          <!-- Timeline node -->
          <span class="absolute left-0 top-3 hidden h-2 w-2 bg-mech-cyan md:block clip-mech-sm opacity-60 group-hover:opacity-100 transition-opacity"></span>

          <div class="mech-panel p-6">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <h3 class="font-display font-bold text-lg text-mech-text uppercase tracking-wide">{exp.company}</h3>
                <p class="text-sm font-mono text-mech-cyan mt-0.5">{exp.role}</p>
              </div>
              <span class="inline-flex font-mono text-xs text-mech-text-secondary bg-mech-base border border-mech-border px-3 py-1 clip-mech-sm">
                {exp.period} — {exp.location}
              </span>
            </div>
            <p class="mt-4 text-sm leading-7 text-mech-text-secondary">{exp.description}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {exp.tech.map((t) => (
                <span class="mech-tag">{t}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
