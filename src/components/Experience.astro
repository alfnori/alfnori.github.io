---
import { experiences } from "../data/cv";
---

<section id="experiencia" class="mx-auto max-w-5xl px-6 py-8">
  <h2 class="text-sm font-semibold tracking-widest text-zinc-500 dark:text-zinc-400 uppercase">Experiência Profissional</h2>

  <div class="mt-6 relative">
    <!-- line -->
    <div class="absolute left-2 top-2 bottom-2 w-px bg-zinc-200 dark:bg-zinc-800 hidden md:block"></div>

    <div class="space-y-8">
      {experiences.map((exp) => (
        <article class="relative md:pl-8">
          <span class="absolute left-0 top-1.5 hidden h-3 w-3 rounded-full border-2 border-white bg-blue-600 dark:border-zinc-950 md:block shadow"></span>
          <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/50 hover:shadow-sm transition">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <h3 class="font-semibold text-zinc-900 dark:text-white">{exp.company}</h3>
                <p class="text-sm font-medium text-blue-600 dark:text-blue-400">{exp.role}</p>
              </div>
              <span class="inline-flex rounded-full bg-zinc-100 px-3 py-1 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                {exp.period} • {exp.location}
              </span>
            </div>
            <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{exp.description}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {exp.tech.map((t) => (
                <span class="rounded-full bg-zinc-900 px-2.5 py-1 text-xs font-medium text-white dark:bg-white dark:text-zinc-900">{t}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
